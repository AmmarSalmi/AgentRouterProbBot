# Copy to .env for Docker Compose on Windows or Linux.

# Optional AgentRouter model key (sk-...) for direct probes. Leave blank for Telegram setup.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org

# Optional dashboard access token and matching numeric account ID. Leave blank for Telegram setup.
AGENTROUTER_DASHBOARD_TOKEN=
AGENTROUTER_USER_ID=

# Telegram bot created through @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Optional: leave blank, start the service, then press Start in the bot's private chat.
TELEGRAM_CHAT_ID=

# Default interval between discovery and probe cycles. The bot menu can override it.
POLL_SECONDS=900
PROBE_MAX_OUTPUT_TOKENS=32
PROBE_REASONING_EFFORT=low
PROBE_CONCURRENCY=2
# Warn when the probing key's remaining quota falls below this USD amount.
PROBE_KEY_LOW_BALANCE_USD=1.00
REQUEST_TIMEOUT_SECONDS=90
HEALTH_MAX_AGE_SECONDS=3600
LOG_LEVEL=INFO
